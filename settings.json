        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "mcp-apps": {
      "source": {
        "source": "github",
        "repo": "modelcontextprotocol/ext-apps"
      }
